# --- Supabase (required) ---------------------------------------------------
# Project URL and public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security; never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ------------------------------------------------------------------
# Canonical origin used for metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron and internal service auth ---------------------------------------
# Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=generate-a-long-random-string

# Read-only key for /api/v1 and the internal scanner bypass.
JARVIS_READONLY_API_KEY=generate-another-long-random-string

# --- Email (optional) ------------------------------------------------------
# Leave RESEND_API_KEY empty to disable all outgoing mail.
RESEND_API_KEY=
JARVIS_EMAIL_FROM=Jarvis Research <onboarding@resend.dev>
# Owner recipients always receive the digest. Comma-separated.
JARVIS_EMAIL_TO=owner@example.com

# --- Market and macro data (optional) -------------------------------------
# FRED falls back to its keyless CSV endpoint when this is empty.
FRED_API_KEY=
# Adds EODHD fundamentals to /api/stock-detail.
EODHD_API_TOKEN=
# Enables the economic calendar.
TRADING_ECONOMICS_API_KEY=

# Comma-separated tickers allowed in the optional short overlay, e.g.
# JARVIS_SHORT_ELIGIBLE=BBCA,BBRI,BMRI
JARVIS_SHORT_ELIGIBLE=
