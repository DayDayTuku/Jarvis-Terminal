{
  "name": "jarvis-research-terminal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import ./tests/node-test-setup.mjs --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "backtest": "node --experimental-strip-types scripts/backtest.ts",
    "fit-score": "node --experimental-strip-types scripts/fit-score.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "2.115.0",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
